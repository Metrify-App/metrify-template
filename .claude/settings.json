{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git merge-base:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",

      "Bash(make help:*)",
      "Bash(make install:*)",
      "Bash(make format:*)",
      "Bash(make format-check:*)",
      "Bash(make lint:*)",
      "Bash(make typecheck:*)",
      "Bash(make test:*)",
      "Bash(make fix:*)",
      "Bash(make check:*)",

      "Bash(bash .claude/skills/metrify-quality/scripts/check-standard.sh:*)"
    ]
  }
}
